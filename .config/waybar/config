{
  "layer": "top",
  "position": "top",
  "height": 28,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": ["hyprland/workspaces", "mpris"],
  "modules-center": ["clock"],
  "modules-right": ["custom/cpu_temp", "custom/nvidia_gpu_temp", "custom/nvme_temp", "cpu", "custom/nvidia_gpu", "memory", "battery", "pulseaudio", "bluetooth", "network", "custom/power_profile", "custom/notification", "idle_inhibitor", "tray"],
  "hyprland/workspaces": {
    "show-special": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip-format-activated": "Caffeine {status}",
    "tooltip-format-deactivated": "Caffeine {status}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "mpris": {
	"format": "{player_icon} {dynamic}",
	"format-paused": "{status_icon} <i>{dynamic}</i>",
    "max-length": 30,
    "interval": 1,
    "player-icons": {
      "default": "▶",
      "spotify": "",
      "firefox": "󰈹",
    },
    "status-icons": {
      "paused": "",
      "stopped": ""
    },
    "ignored-players": ["playerctld"]
  },
  "bluetooth": {
    "format": " {status}",
    "format-connected": " {num_connections}",
    "format-disabled": " off",
    "tooltip-format": "{controller_alias}\n{controller_address}",
    "on-click": "blueman-manager",
    "on-click-right": "bash -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on'"
  },

  "clock": {
    "format": "  {:%H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A | %d %B %Y}"
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "󰍛 {used:0.1f}G"
  },
  "custom/nvidia_gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "interval": 5,
    "format": "  {text}%"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": ["","",""],
    "on-click": "pavucontrol"
  },

  "custom/cpu_temp": {
    "exec": "sensors k10temp-pci-00c3 | grep Tctl | awk '{print $2}'",
    "interval": 5,
    "format": " {text}"
  },

  "custom/nvme_temp": {
    "exec": "sensors nvme-pci-0200 | grep 'Composite' | awk '{print $2}'",
    "interval": 10,
    "format": " {text}"
  },
  "custom/nvidia_gpu_temp": {
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
    "interval": 5,
    "format": "  {text}°C"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}"
  },

  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "tooltip-format": "{essid} @ {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "custom/power_profile": {
    "exec": "~/.config/waybar/scripts/power-profile.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/power-profile.sh --pick"
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#FFD700'>󰂚</span>",
      "none": "󰂜",
      "dnd-notification": "<span foreground='#FFD700'>󰂛</span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "<span foreground='#FFD700'>󰂚</span>",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "<span foreground='#FFD700'>󰂛</span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "exec-if": "which swaync-client",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "tray": {
    "spacing": 8
  }
}
