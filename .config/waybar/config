{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": ["hyprland/workspaces", "mpris"],
  "modules-center": ["clock"],
  "modules-right": ["custom/cpu_temp", "custom/nvidia_gpu_temp", "custom/nvme_temp", "cpu", "custom/nvidia_gpu", "memory", "pulseaudio", "network", "idle_inhibitor", "tray"],
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip-format-activated": "Caffeine {status}",
    "tooltip-format-deactivated": "Caffeine {status}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "mpris": {
	"format": "{player-icon} {dynamic}",
	"format-paused": " <i>{dynamic}</i>",
    "max-length": 30,
    "player-icons": {
      "default": "▶"
    }
  },
  "clock": {
    "format": "  {:%H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A | %d %B %Y}"
  },
  "cpu": {
    "format": " {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "󰍛 {used:0.1f}G"
  },
  "custom/nvidia_gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "interval": 5,
    "format": "  {text}%"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁",
    "format-icons": ["","",""],
    "on-click": "pavucontrol"
  },

  "custom/cpu_temp": {
    "exec": "sensors k10temp-pci-00c3 | grep Tctl | awk '{print $2}'",
    "interval": 5,
    "format": " {text}"
  },

  "custom/nvme_temp": {
    "exec": "sensors nvme-pci-0200 | grep 'Composite' | awk '{print $2}'",
    "interval": 10,
    "format": " {text}"
  },
  "custom/nvidia_gpu_temp": {
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
    "interval": 5,
    "format": "  {text}°C"
  },
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "󰈀",
    "tooltip-format": "{essid} @ {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "tray": {
    "spacing": 8
  }
}
